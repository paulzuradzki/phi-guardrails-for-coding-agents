# Copy to .env and adjust. .env is gitignored; never commit it.

# Single connection string used by the app. Toggle the active role by
# swapping this value:
#   human:  postgresql://human001:fake-human-password@localhost:5432/claims_db
#   agent:  postgresql://agent001:fake-agent-password@localhost:5432/claims_db
DATABASE_URL=postgresql://human001:fake-human-password@localhost:5432/claims_db

# --- Docker compose variables (used to seed the container, not by the app) ---
DB_USER=human001
DB_PASSWORD=fake-human-password
DB_NAME=claims_db
AGENT_DB_USER=agent001
AGENT_DB_PASSWORD=fake-agent-password
